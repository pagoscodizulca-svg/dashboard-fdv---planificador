# ============================================================================
# CONFIGURACIÓN EXCLUSIVA DE SERVIDOR (NUNCA EXPONER CON PREFIJO VITE_*)
# ============================================================================
PORT=3000
NODE_ENV=development

# Google Sheets (solo ID y GIDs opcionales — nunca Service Account JSON ni tokens en el frontend)
GOOGLE_SHEET_ID=<GOOGLE_SHEET_ID>
SHEETS_SYNC_INTERVAL_MS=60000
GOOGLE_SHEET_GID_GRID=<GID_HOJA_GRID>
GOOGLE_SHEET_GID_VOLUMEN=<GID_HOJA_VOLUMEN>
GOOGLE_SHEET_GID_CLIENTES=<GID_HOJA_CLIENTES>
GOOGLE_SHEET_GID_DEGUSTACIONES=<GID_HOJA_DEGUSTACIONES>
GOOGLE_SHEET_GID_USUARIOS=<GID_HOJA_USUARIOS>
GOOGLE_SHEET_GID_AZUCAR=<GID_HOJA_AZUCAR>
GOOGLE_SHEET_GID_LECHE=<GID_HOJA_LECHE>
GOOGLE_SHEET_GID_POLLO=<GID_HOJA_POLLO>
GOOGLE_SHEET_GID_ASTURIAS=<GID_HOJA_ASTURIAS>
GOOGLE_SHEET_GID_SALPICAO=<GID_HOJA_SALPICAO>

# Supabase & Seguridad de Backend (Planificador FDV)
SUPABASE_URL=<SUPABASE_URL>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# Supabase Compartido de Trade Marketing (Aislamiento Multisede 'CENTRO' | 'OCCIDENTE')
# Si se omiten, usa automáticamente SUPABASE_URL y las llaves primarias.
TRADE_SUPABASE_URL=<TRADE_MARKETING_SUPABASE_URL>
TRADE_SUPABASE_ANON_KEY=<TRADE_MARKETING_SUPABASE_ANON_KEY>
TRADE_SUPABASE_SERVICE_ROLE_KEY=<TRADE_MARKETING_SUPABASE_SERVICE_ROLE_KEY>
TRADE_SUPABASE_JWT_SECRET=<OPTIONAL_TRADE_SUPABASE_JWT_SECRET_FOR_RLS_SCOPED_TOKENS>

JWT_SECRET=<JWT_SECRET>
SYNC_SECRET_TOKEN=<SYNC_SECRET_TOKEN>
GEMINI_API_KEY=<GEMINI_API_KEY>
ADMIN_PASSWORD_HASH=<ADMIN_PASSWORD_HASH>

# Integraciones Externas (Servidor)
GOOGLE_SCRIPT_WEBHOOK_URL=<GOOGLE_SCRIPT_WEBHOOK_URL>
GERENCIA_TRADE_API_URL=<GERENCIA_TRADE_API_URL>
GERENCIA_SUPABASE_SURVEYS_URL=<GERENCIA_SUPABASE_SURVEYS_URL>

# ============================================================================
# CONFIGURACIÓN PÚBLICA DE CLIENTE (SOLO CLAVES PUBLISHABLE / ANON CON RLS)
# ============================================================================
VITE_SUPABASE_URL=<SUPABASE_URL>
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
